{
  "name": "rsync-crypt",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,relabel=private",
  "workspaceFolder": "${localWorkspaceFolder}",
  "runArgs": [
    "--userns=keep-id:uid=1000,gid=1000",
    "--security-opt",
    "label=type:container_engine_t",
    "--security-opt",
    "label=level:s0:c555,c666",
    "--device",
    "/dev/fuse",
    "--device",
    "/dev/net/tun",
    "--security-opt",
    "unmask=/proc/sys",
    "--secret",
    "gh-devcontainer,type=env,target=GH_TOKEN"
  ],
  "mounts": [
    "source=${localEnv:XDG_RUNTIME_DIR}/devcontainer-ssh,target=/run/devcontainer-ssh,type=bind"
  ],
  "containerEnv": {
    "CONTAINERS_CONF_OVERRIDE": "/usr/local/share/devcontainer/containers-bridge-network.conf"
  },
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/run/devcontainer-ssh/agent.sock",
    "GIT_SSH_COMMAND": "ssh -o UserKnownHostsFile=/run/devcontainer-ssh/known_hosts -o StrictHostKeyChecking=yes"
  },
  "remoteUser": "dev",
  "updateRemoteUserUID": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "Anthropic.claude-code",
        "openai.chatgpt",
        "ms-vscode-remote.remote-containers",
        "vscode-icons-team.vscode-icons"
      ]
    }
  }
}
