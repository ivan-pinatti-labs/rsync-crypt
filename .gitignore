### VisualStudioCode ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Visual Code Workspace
*.code-workspace

### VisualStudioCode Patch ###
# Ignore all local history of files
.history
.ionide

# Dependency directories
node_modules/
jspm_packages/

# dotenv ###
.env
.env.*
!.env.example

# conf profiles ###
# The .example.txt files are the shipped templates and are tracked. Every
# other .txt in conf/ is somebody's own copy, made by hand or by
# 'make new-profile NAME=<profile>', and stays local so a pull never
# conflicts with a customised filter list.
conf/*.txt
!conf/*.example.txt

# known hosts
files/ssh/known_hosts

### Python / tests ###
__pycache__/
*.py[cod]
.pytest_cache/
tests/.venv/

# Personal AI agent files, never committed (see AGENTS.md)
CLAUDE.local.md
.claude/settings.local.json
.claude/agents/local/
.claude/worktrees/
