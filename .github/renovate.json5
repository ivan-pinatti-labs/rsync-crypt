{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Renovate is the only dependency bot here now. Dependabot's `updates:`
  // configuration (github-actions, pre-commit) is retired and
  // .github/dependabot.yml deleted; both ecosystems moved to Renovate's own
  // native managers below rather than to a second custom regex, since each
  // already ships one. Renovate still separately handles the asdf tool
  // versions and the Alpine pin in the Dockerfile, neither of which a
  // manifest-reading manager can parse.
  extends: ["config:recommended"],

  // Kept on despite the standing, never-resolving tracking issue it opens.
  // Without it, "Renovate found nothing to update" and "Renovate silently
  // stopped seeing your dependencies" look identical, and the dashboard is the
  // only place Renovate reports detection errors and rate-limited updates.
  // That matters most for the custom regex manager below, which depends on a
  // hand-written pattern that will match nothing, silently, if the Dockerfile
  // is renamed or its `# renovate:` annotation format changes.
  dependencyDashboard: true,

  timezone: "America/Toronto",

  // Daily, not weekly. A weekly schedule stacked against minimumReleaseAge's
  // 7 day window below means a release that misses one week's slot by a day
  // waits a full extra week for the next one, so the oldest a package could
  // sit before merging was up to 14 days even though 7 was the intended
  // floor. Checking daily keeps the schedule's own period short enough that
  // it can no longer add more than a day on top of that floor.
  schedule: ["before 7am"],

  labels: ["dependencies"],
  commitMessagePrefix: "chore:",

  // Keep PR volume manageable so CI is not overwhelmed.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  // The default deny. Overridden per update type by the first packageRules
  // entry below, which is the only place that grants it: an update type this
  // config has not thought about, or a datasource added later with no rule of
  // its own, arrives unlabelled and waits for a person rather than merging on
  // the strength of a default nobody chose.
  automerge: false,

  // Dependabot used to own these two ecosystems; disabling them here avoided
  // duplicate pull requests for the same update. Dependabot's `updates:`
  // configuration is retired now (.github/dependabot.yml no longer exists),
  // so both are enabled here instead.
  //
  // `dockerfile` is enabled and scoped, not left off. Unscoped it would read
  // the root Dockerfile's `FROM alpine:${ALPINE_VERSION}` line that the
  // custom.regex manager below already owns, which is the duplicate this
  // allowlist has always existed to prevent. A pair of packageRules entries
  // further down is what scopes it: the first disables everything the
  // dockerfile manager finds, the second enables .devcontainer/Dockerfile
  // alone, whose base image digest no other manager here watches, so the two
  // never see the same line. Scoping by rule alone would not do it, because
  // matchFileNames narrows a rule and not what a manager reads.
  enabledManagers: [
    "asdf",
    "custom.regex",
    "github-actions",
    "pre-commit",
    "dockerfile",
  ],

  // Off by default upstream, "not supported by the pre-commit maintainers or
  // community" per the manager's own warning, a statement about where bug
  // reports go rather than a reason to leave hook revisions unwatched.
  // Listing it in enabledManagers above is not enough on its own: this
  // manager ships `enabled: false` in its own defaultConfig regardless,
  // confirmed with `renovate --platform=local --dry-run=extract` before
  // relying on it, so without this override it would sit listed as enabled
  // and extract nothing.
  "pre-commit": {
    enabled: true,
  },

  // A cooling window before an update is offered at all, mirroring
  // docker-torrent-box-with-vpn's reasoning rather than its number chosen for
  // a much larger fleet of container images: `Pin Only` proves a diff changed
  // nothing but a version token, and says so in its own docstring, but it
  // cannot tell a good release from a backdoored one, because a fresh supply
  // chain attack has no advisory yet for any scanner to match. Age is the
  // only defence against that, and granting automerge above without it would
  // have meant merging a release published minutes earlier, unattended, with
  // no person ever looking, which is the exact window a compromised upstream
  // release is exploited in.
  //
  // Seven days, the same as the sibling repository, not because the number
  // was copied but because the reasoning behind it is not about fleet size:
  // most compromised releases are spotted and pulled within hours to days
  // regardless of how many images or tools a repository tracks, so the
  // window that makes "we merged it first" into "it was already yanked" is
  // the same window here as there. This repository's surface is asdf tool
  // versions (github-cli, pre-commit), one annotated Docker tag
  // (ALPINE_VERSION), and, since the migration off Dependabot, GitHub
  // Actions and pre-commit hooks too; none of the five carry a materially
  // different risk profile that would justify a shorter wait, and the two
  // that moved from Dependabot are the larger attack surface of the whole
  // set, not the smaller, since both execute arbitrary code (in CI holding a
  // token, and on a developer's machine respectively) rather than merely
  // naming a version.
  minimumReleaseAge: "7 days",

  // Hold the pull request until the window is satisfied rather than opening
  // one that is not allowed to merge yet. Without this, `minimumReleaseAge`
  // still gates the merge, but Renovate opens the pull request immediately
  // regardless, so it would sit for up to seven days looking blocked for no
  // visible reason instead of not existing yet.
  internalChecksFilter: "strict",

  // The exception: a fix for a known vulnerability is not made safer by
  // aging, and null clears the inherited window for these updates only.
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },

  packageRules: [
    // What may merge without anyone looking, and the label that says so.
    //
    // First in the list on purpose, the same reason it is first in
    // docker-torrent-box-with-vpn's copy of this file: later rules win on any
    // key they share with an earlier one, and the two group rules below set
    // names and labels, not automerge policy, so neither can accidentally
    // override this by coming after it.
    //
    // The label is the whole point. bot-auto-merge.yml approves a Renovate
    // pull request only when it carries `automerge`, reading the label
    // rather than restating which update types are eligible, so the policy
    // lives here, once, instead of two copies free to drift apart. `Pin
    // Only` is the actual security gate behind that trust: every changed
    // line still has to be nothing but a version in a pin position, checked
    // line by line, before the label alone can do anything.
    //
    // patch and minor only, not this repository's whole update-type
    // vocabulary. Every manager here can offer a major: `asdf` for
    // github-cli or pre-commit, the custom regex manager's `versioning:
    // docker` for ALPINE_VERSION (where "3.24" to "3.25" reads as minor but
    // "3.x" to "4.x" would read as major), and, since the migration off
    // Dependabot, `github-actions` and `pre-commit` too, the same
    // major/minor/patch semver Dependabot used to classify on its own pull
    // requests through bot-auto-merge.yml's use of dependabot/fetch-metadata,
    // which retired along with its `updates:` configuration. An Alpine major
    // is exactly the case AGENTS.md already says needs a person: apk drops
    // and renames packages across major releases, which is what forced the
    // apk pins in the Dockerfile to be re-resolved by hand the last time this
    // repository's base image moved; a major GitHub Action or pre-commit
    // hook bump earns the same pause, since neither promises backward
    // compatibility across one either.
    //
    // digest is listed for the same reason docker-torrent-box-with-vpn's
    // copy of this file lists it: every action under .github/workflows/ is
    // pinned to a full commit SHA with a trailing `# vX.Y.Z` comment, which
    // is exactly the shape github-actions's own `digest` update type covers,
    // a rebuilt tag pointing at a new commit with no version change to
    // announce it. Leaving digest out would not have kept a policy
    // unexercised the way it did before this repository had a github-actions
    // manager at all: it would have meant every one of those SHA refreshes,
    // the routine case rather than the exception, arrives unlabelled and
    // waits for a person, the automerge path pin-only diffs are supposed to
    // have. `scripts/assert-pin-only-diff.py`'s version grammar already
    // accepts a changed action SHA as a pin-position change, confirmed
    // against `ACTION_SHA` in that script, so `Pin Only` is still the actual
    // gate behind this label; digest reaching automerge does not bypass it.
    // `pin` stays off the list: `pinDigests` is not enabled anywhere in this
    // config, so nothing here can ever produce a `pin` update, unlike
    // `digest`, which github-actions produces on its own.
    {
      matchUpdateTypes: ["patch", "minor", "digest"],
      automerge: true,
      addLabels: ["automerge"],
    },
    {
      matchManagers: ["asdf"],
      groupName: "asdf tool versions",
      groupSlug: "asdf-tools",
      labels: ["dependencies", "tooling"],
    },
    // Everything the dockerfile manager finds is disabled here, and the one
    // path this repository wants watched is enabled again by the rule below.
    // Both halves are load-bearing, for two different reasons.
    //
    // The root Dockerfile belongs to the custom.regex manager further down,
    // which owns `ARG ALPINE_VERSION` along with the seven apk `~=` pins
    // that deliberately sit outside Renovate's reach for the reasons in
    // AGENTS.md. Enabling the dockerfile manager makes Renovate extract
    // every Dockerfile in the repository: confirmed with a dry-run=extract,
    // which read `ARG ALPINE_VERSION=3.24` a second time, once through this
    // manager and once through the annotated custom regex that has always
    // owned it. Two managers proposing the same pin is the duplicate the
    // enabledManagers allowlist above was written to prevent. Disabling the
    // manager rather than one file by name leaves custom.regex untouched,
    // since matchManagers scopes this rule to the dockerfile manager alone.
    //
    // Naming the file instead would not hold. matchFileNames on a rule
    // scopes that rule, never which files a manager reads, so an exclusion
    // written as matchFileNames: ["Dockerfile"] covers only the Dockerfile
    // that exists today and leaves any added later watched. That matters
    // more here than in the sibling repositories: the first rule above
    // grants automerge to `digest` updates, for the action SHA refreshes
    // that are its routine case, so a future Dockerfile's digest bump would
    // merge unattended on the strength of a grant meant for something else.
    // Disabling the manager wholesale and re-enabling one path cannot drift
    // that way. Raised by CodeRabbit on ivan-pinatti-labs/.github#13 and
    // fixed the same way there.
    {
      matchManagers: ["dockerfile"],
      enabled: false,
    },
    // The development container's base image, pinned by digest in
    // .devcontainer/Dockerfile.
    //
    // Merged unattended, like every other pin here. This is the
    // organization's own image, built by ivan-pinatti-labs/devcontainer-images,
    // and the quality gate lives there rather than in each consumer: that
    // repository ages its own upstream inputs through a seven day
    // minimumReleaseAge, sends Ubuntu minor and major moves and asdf bumps to a
    // person, and only publishes from a reviewed merge to main. A digest
    // arriving here has therefore already passed that gate, and `Pin Only`
    // grades the `ARG BASE_IMAGE=<image>@sha256:<digest>` line (IMAGE_DIGEST in
    // scripts/assert-pin-only-diff.py), so the ordinary bot lane approves it.
    // GHCR returns no release timestamp for a digest, so under Renovate's
    // default minimumReleaseAgeBehaviour (timestamp-required) the seven day
    // window above would hold every base image bump forever and, with
    // internalChecksFilter strict, never open the pull request at all.
    // Measured with a dry-run=full: "digest update of
    // ghcr.io/ivan-pinatti-labs/devcontainer-base has no releaseTimestamp to
    // age against". timestamp-optional lets the update be offered; the seven
    // day window is applied upstream instead, in devcontainer-images, where the
    // image's own inputs are aged before anything is published.
    {
      matchManagers: ["dockerfile"],
      matchFileNames: [".devcontainer/Dockerfile"],
      enabled: true,
      groupName: "development container base image",
      groupSlug: "devcontainer-base",
      labels: ["dependencies", "tooling"],
      minimumReleaseAgeBehaviour: "timestamp-optional",
      automerge: true,
      addLabels: ["automerge"],
    },
    // Scoped to the datasource rather than to the manager: the second custom
    // regex manager below watches asdf plugin commits through git-refs, which
    // are not a Docker tag and get their own rule further down.
    {
      matchManagers: ["custom.regex"],
      matchDatasources: ["docker"],
      labels: ["dependencies", "docker"],
    },
    // An asdf plugin is code: `asdf install` runs its scripts to download and
    // install each tool, inside a development container that holds a GitHub
    // token. A new plugin commit therefore waits for a person to read what
    // changed in that plugin.
    //
    // automerge: false is load-bearing here in a way it is not in the sibling
    // repositories. This repository grants automerge to `digest` updates
    // (see the first rule above, for the action SHA refreshes that are its
    // routine case), and a git-refs commit bump is a digest update, so
    // without this rule a plugin commit would merge unattended on the
    // strength of a grant meant for something else. Later rules win on a
    // shared key, so this one has to sit after that grant, which it does.
    //
    // git-refs publishes no release timestamps, and under Renovate's default
    // minimumReleaseAgeBehaviour (timestamp-required) the 7 day window above
    // would then hold every plugin commit back forever, silently.
    // timestamp-optional lets the update be offered; the review stands in for
    // the age window here.
    {
      matchManagers: ["custom.regex"],
      matchDatasources: ["git-refs"],
      matchFileNames: [".devcontainer/asdf-plugins"],
      groupName: "asdf plugins",
      groupSlug: "asdf-plugins",
      labels: ["dependencies", "tooling"],
      minimumReleaseAgeBehaviour: "timestamp-optional",
      automerge: false,
    },
    // The two ecosystems that moved here from Dependabot, each grouped the
    // way Dependabot grouped it: one pull request per ecosystem
    // (`patterns: ["*"]` in the old dependabot.yml), rather than one per
    // dependency. That was about pull request volume, not a shared release
    // cadence, and nothing about the reasoning changes just because a
    // different bot is now the one opening the pull request. Labels match
    // what dependabot.yml used to add, on top of the root `dependencies`
    // label every Renovate pull request already carries, so a pull request
    // from either era of this repository's history sorts the same way.
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      groupSlug: "github-actions",
      labels: ["dependencies", "github-actions"],
    },
    {
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
      groupSlug: "pre-commit-hooks",
      labels: ["dependencies", "pre-commit"],
    },
    // The github-actions manager extracts more than uses: pins by default:
    // pull-request-validation.yml's python-version: "3.13" passed to
    // actions/setup-python's with: (depType uses-with) is exactly what PR
    // #82 proved live, proposing 3.13 to 3.14 with no way to ever merge it.
    // Dependabot's github-actions ecosystem never watched this shape, it
    // bumped uses: pins only, and scripts/assert-pin-only-diff.py's
    // REV_PIN and ACTION_SHA patterns do not match a with: input either, so
    // Pin Only was always going to refuse a diff like this and route it to
    // a person, the same person it will keep routing every future Python
    // release to, forever, unless this manager stops proposing the shape.
    // Disabled here so this repository stops generating a pull request
    // that can never pass its own required check, rather than leaving that
    // outcome to repeat every time upstream Python cuts a release.
    // matchDepTypes also covers github-runner (a literal runs-on: value)
    // for the same reason, even though nothing here happens to use one
    // today; pre-commit-checklists and pre-commit-checklists-demo both
    // carry the identical rule for the identical reason.
    {
      matchManagers: ["github-actions"],
      matchDepTypes: ["github-runner", "uses-with"],
      enabled: false,
    },
  ],

  customManagers: [
    {
      // Matches the pattern, in the Dockerfile:
      //   # renovate: datasource=<ds> depName=<name> [versioning=<scheme>]
      //   ARG VAR=<currentValue>
      //
      // This is Renovate's own documented convention for annotating a
      // Dockerfile ARG (see docs.renovatebot.com/modules/manager/regex/,
      // "Using regex manager to update Dockerfile ARG"), which is why the
      // pins moved out of `.env.example` and into the Dockerfile: the file
      // that actually consumes a version now also declares it, and the
      // annotation sits in the shape Renovate documents rather than one
      // invented for an env file. The value is unquoted here, unlike the
      // `VAR="value"` shape this pattern used to match, so `[^\\s]+` ends the
      // capture at the end of the line rather than at a closing quote.
      //
      // GOCRYPTFS_VERSION, BASH_VERSION, LESS_VERSION, OPENSSH_VERSION,
      // RSYNC_VERSION, SSHFS_VERSION and VIM_VERSION are all intentionally
      // left unannotated: each is an apk `~=` version constraint rather than
      // a Docker tag, resolved against whichever Alpine release
      // ALPINE_VERSION pins, which carries exactly one version of each
      // package in its community/main repos. No Renovate datasource here
      // models "the version of this apk package available in Alpine release
      // X", so an independently tracked bump could easily propose a version
      // that does not exist in that release's repo and fail the build. All
      // seven carry a `# apk-pin:` marker instead and are re-resolved by
      // .github/workflows/resolve-apk-pins.yml (`apk policy <pkg>` inside the
      // target `alpine:${ALPINE_VERSION}`) whenever ALPINE_VERSION moves.
      customType: "regex",
      managerFilePatterns: ["/^Dockerfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s+ARG [A-Z0-9_]+=(?<currentValue>[^\\s]+)",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      // The asdf plugin commits the development container pins in
      // .devcontainer/asdf-plugins, one line per plugin: name, repository
      // URL, branch, commit. git-refs reads the named branch's current
      // commit, so a new commit there arrives as a digest update to that
      // line. See the matching packageRules entry above for why a person
      // reviews every one of these, which is the opposite of how this
      // repository treats every other digest update.
      customType: "regex",
      managerFilePatterns: ["/^\\.devcontainer/asdf-plugins$/"],
      matchStrings: [
        "(?<depName>[a-z0-9-]+) (?<packageName>https://\\S+) (?<currentValue>\\S+) (?<currentDigest>[0-9a-f]{40})",
      ],
      datasourceTemplate: "git-refs",
    },
  ],
}
